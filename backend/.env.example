# App
APP_ENV=development
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
# Seed partners, inspirations, and bundled capabilities on startup (default: false)
POCP_FULL_SEED=false
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=10080

# Database (PostgreSQL recommended; SQLite for quick local dev without Docker)
# Docker Compose default:
# DATABASE_URL=postgresql+psycopg://pocp:pocp@localhost:5432/pocp
# Local SQLite (no Postgres):
# DATABASE_URL=sqlite:///./data/pocp.db
DATABASE_URL=postgresql+psycopg://pocp:pocp@localhost:5432/pocp
POCP_WAIT_FOR_DB=true
POCP_WAIT_FOR_DB_SECONDS=60
POCP_DB_POOL_SIZE=5
POCP_DB_MAX_OVERFLOW=10

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:8000/api/v1/auth/github/callback

# AI Providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Sprint Alpha controls
STARTER_AI_CREDITS=100
AI_CHAT_COST_PER_MESSAGE=5
DAILY_CONTRIBUTION_LIMIT=10
DAILY_AI_CREDITS_BURN_LIMIT=200
ENABLE_DEV_LOGIN=true
ENABLE_MOCK_VERIFIER=true

# Federation (v0.2)
POCP_NODE_ID=pocp-node-local
POCP_ALLOW_UNTRUSTED_IMPORT=false
POCP_FEDERATION_TRUST_WEIGHT=0.5
# POCP_TRUSTED_NODES=[{"node_id":"peer-a","base_url":"http://peer:8000","public_key":"<hex>","trust_weight":0.5}]
POCP_REQUIRE_IMPORT_SIGNATURE=false
POCP_VERIFY_REMOTE_LEDGER=true
POCP_NODE_MODE=full
POCP_FEDERATION_SYNC_ON_STARTUP=false

# Quantum-ready crypto (see docs/QUANTUM-READINESS.md)
# POCP_CRYPTO_SUITE=pocp-crypto-v0.2-hybrid
# POCP_MIN_CRYPTO_SUITE=pocp-crypto-v0.2-hybrid
# POCP_REQUIRE_PQC_SIGNATURE=true
# POCP_NODE_PRIVATE_KEY=<ed25519-hex>
# POCP_NODE_PUBLIC_KEY=<ed25519-pub-hex>
# POCP_NODE_PQC_PRIVATE_KEY=<from scripts/generate_pqc_keys.py>
# POCP_NODE_PQC_PUBLIC_KEY=<pqc-pub-hex>
# pocp-crypto-v0.3-hash uses SHA-3-256 for new ledger rows

# Neural network stack (GitHub adoption — see docs/NEURAL-NETWORK-GITHUB-ADOPTION.md)
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2
# OLLAMA_EMBED_MODEL=nomic-embed-text
# ENABLE_OLLAMA_VERIFIER=false
# ENABLE_OLLAMA_EMBEDDINGS=false
# OLLAMA_EMBED_MATCH_WEIGHT=0.45
# POCP_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# StudyAgent (NN-3) — POST /api/v1/intelligence/agents/study/run
# STUDY_AGENT_LLM_PROVIDER=mock
# ENABLE_LANGGRAPH_STUDY_AGENT=false

# Auto-finalization (witness quorum) — see docs/ACCOUNTABILITY-BOUNDARY.md
# ENABLE_AUTO_FINALIZATION=true
# POCP_FINALIZER_ENTITY_ID=pocp-entity-clarion-0

# Distributed compute & embeddings — see docs/DISTRIBUTED-LAYERS.md
# ENABLE_VLLM_VERIFIER=false
# ENABLE_VLLM_CHAT=false
# VLLM_BASE_URL=http://127.0.0.1:8000
# VLLM_MODEL=meta-llama/Meta-Llama-3-8B-Instruct
# ENABLE_LLAMA_CPP_VERIFIER=false
# ENABLE_LLAMA_CPP_CHAT=false
# LLAMA_CPP_BASE_URL=http://127.0.0.1:8080
# LLAMA_CPP_MODEL=llama
# LLAMA_CPP_TIMEOUT_SECONDS=120
# ENABLE_CREWAI_WITNESS=false
# ENABLE_CREWAI_WITNESS_USE_LIBRARY=false
# CREWAI_WITNESS_URL=
# CREWAI_WITNESS_LLM_PROVIDER=mock
# CREWAI_WITNESS_TIMEOUT_SECONDS=120
# ENABLE_SENTENCE_TRANSFORMERS=false
# POCP_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# POCP_EMBED_MATCH_WEIGHT=0.45
# POCP_SEMANTIC_DEDUP_THRESHOLD=0.88
# ENABLE_SEMANTIC_DEDUP_BLOCK=false

# Capability integration — MCP live invoke (see docs/CAPABILITY-INTEGRATION.md)
# ENABLE_MCP_LIVE_INVOKE=false
# MCP_STDIO_TIMEOUT=60
# MCP_HTTP_TIMEOUT=60

# Federated peer compute (NN-5) — see docs/DISTRIBUTED-LAYERS.md
# ENABLE_PEER_COMPUTE=false
# POCP_ALLOW_PEER_WITNESS=false
# ENABLE_PEER_MCP=false
# ENABLE_PEER_MCP_PREFER_PEER=false
# POCP_PEER_MCP_TIMEOUT=90
# POCP_PEER_COMPUTE_SECRET=
# POCP_PEER_WITNESS_TIMEOUT=90
# POCP_PEER_HANDSHAKE_MODE=shared_secret   # shared_secret | challenge
# POCP_PEER_HANDSHAKE_TTL_SECONDS=300
# POCP_PEER_CLOCK_SKEW_SECONDS=120
# POCP_PEER_PREFER_ED25519=false
# POCP_PEER_REQUIRE_TRUSTED_NODE=false
# POCP_SYNC_INTELLIGENCE_BUNDLE=true
# ENABLE_PYG_GRAPH_ADVISORY=false
