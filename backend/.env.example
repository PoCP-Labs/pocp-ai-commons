# App
APP_ENV=development
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=10080

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:8000/api/v1/auth/github/callback

# AI Providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Sprint Alpha controls
STARTER_AI_CREDITS=100
AI_CHAT_COST_PER_MESSAGE=5
DAILY_CONTRIBUTION_LIMIT=10
DAILY_AI_CREDITS_BURN_LIMIT=200
ENABLE_DEV_LOGIN=true
ENABLE_MOCK_VERIFIER=true
