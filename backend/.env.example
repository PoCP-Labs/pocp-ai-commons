# PoCP AI Commons — Environment Variables
# Copy this file to .env and modify as needed

# --- Database ---
# DATABASE_URL=sqlite:///data/pocp.db
# For PostgreSQL: DATABASE_URL=postgresql://user:pass@host:5432/pocp

# --- Authentication ---
# demo = no auth (local dev), jwt = JWT required
AUTH_MODE=demo
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- CORS ---
# Comma-separated list of allowed origins
CORS_ORIGINS=*

# --- Rate Limiting ---
# Max requests per minute per IP
RATE_LIMIT=100

# --- Logging ---
# DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# --- AI Verification ---
# simulated | deepseek | openai | ollama
AI_VERIFIER_MODEL=simulated
AI_VERIFIER_THRESHOLD=0.7
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Seed ---
# Whether to seed demo data on startup
SEED_ON_STARTUP=true

# --- Default Rewards ---
DEFAULT_REWARD_CP=20
DEFAULT_REWARD_AI_CREDITS=80
REGISTRATION_AI_CREDITS=100
