# Phase A public staging — copy to backend/.env on the staging server:
#   cp backend/.env.staging.example backend/.env
#
# Compose profile (ENABLE_DEV_LOGIN=false overlay):
#   docker compose -f docker-compose.yml -f docker-compose.staging.yml up -d --build
#
# Must align with project-root .env (POSTGRES_PASSWORD, VITE_API_URL) and public DNS.
# Verify before deploy:  python backend/scripts/verify_staging_env.py
# CI template check:     python backend/scripts/verify_staging_env.py --check-example

APP_ENV=staging

# Public URLs (HTTPS) — replace your-staging-host.example with your real domain
BACKEND_URL=https://api.your-staging-host.example
FRONTEND_URL=https://app.your-staging-host.example

# Generate: openssl rand -hex 32
JWT_SECRET=CHANGE_ME-openssl-rand-hex-32
JWT_EXPIRE_MINUTES=10080

# Password must match POSTGRES_PASSWORD in project-root .env
DATABASE_URL=postgresql+psycopg://pocp:CHANGE_ME-postgres-password@postgres:5432/pocp
POCP_WAIT_FOR_DB=true
POCP_WAIT_FOR_DB_SECONDS=60
POCP_DB_POOL_SIZE=5
POCP_DB_MAX_OVERFLOW=10

# GitHub OAuth — required for Phase A staging (ENABLE_DEV_LOGIN=false)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=https://api.your-staging-host.example/api/v1/auth/github/callback

# AI providers (optional; mock verifier can remain enabled as fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

STARTER_AI_CREDITS=100
AI_CHAT_COST_PER_MESSAGE=5
DAILY_CONTRIBUTION_LIMIT=10
DAILY_AI_CREDITS_BURN_LIMIT=200

# Required on public staging — acceptance runner checks POST /auth/dev-login → 403
ENABLE_DEV_LOGIN=false
ENABLE_MOCK_VERIFIER=true

POCP_NODE_ID=pocp-node-staging
POCP_ALLOW_UNTRUSTED_IMPORT=false
POCP_REQUIRE_IMPORT_SIGNATURE=false
# CIP-P2.2 — public federation exchange pair (non-localhost); used by --federation-exchange
# POCP_TRUSTED_NODES=[{"node_id":"staging-a","base_url":"https://api-a.example","public_key":"<hex>","trust_weight":0.5},{"node_id":"staging-b","base_url":"https://api-b.example","public_key":"<hex>","trust_weight":0.5}]
# POCP_STAGING_FEDERATION_NODE_A=https://api-a.example
# POCP_STAGING_FEDERATION_NODE_B=https://api-b.example
# POCP_ACCEPTANCE_BEARER_TOKEN=<jwt from GitHub OAuth on staging Node A>
# CIP-P3.1 — staging requires signed compute receipts (settlement rejects unsigned)
POCP_REQUIRE_RECEIPT_SIGNATURE=true
POCP_SIGN_COMPUTE_RECEIPTS=true
POCP_NODE_MODE=full
POCP_FEDERATION_SYNC_ON_STARTUP=false
