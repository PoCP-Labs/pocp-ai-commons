# Copy to backend/.env on the production server:
#   cp backend/.env.production.example backend/.env
#
# Must align with project-root .env (POSTGRES_PASSWORD, VITE_API_URL) and public DNS.

APP_ENV=production

# Public URLs (HTTPS) — used for OAuth redirects and federation node metadata
BACKEND_URL=https://api.your-domain.com
FRONTEND_URL=https://app.your-domain.com

# Generate: openssl rand -hex 32
JWT_SECRET=replace-with-openssl-rand-hex-32
JWT_EXPIRE_MINUTES=10080

# Password must match POSTGRES_PASSWORD in project-root .env
DATABASE_URL=postgresql+psycopg://pocp:change-me-use-openssl-rand-hex-16@postgres:5432/pocp
POCP_WAIT_FOR_DB=true
POCP_WAIT_FOR_DB_SECONDS=60
POCP_DB_POOL_SIZE=5
POCP_DB_MAX_OVERFLOW=10

# GitHub OAuth (recommended for public deployments)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=https://api.your-domain.com/api/v1/auth/github/callback

# AI providers (optional; mock verifier can remain enabled as fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

STARTER_AI_CREDITS=100
AI_CHAT_COST_PER_MESSAGE=5
DAILY_CONTRIBUTION_LIMIT=10
DAILY_AI_CREDITS_BURN_LIMIT=200

# Disable on the public internet
ENABLE_DEV_LOGIN=false
ENABLE_MOCK_VERIFIER=true

POCP_NODE_ID=pocp-node-production
POCP_ALLOW_UNTRUSTED_IMPORT=false
POCP_REQUIRE_IMPORT_SIGNATURE=false
POCP_NODE_MODE=full
POCP_FEDERATION_SYNC_ON_STARTUP=false
