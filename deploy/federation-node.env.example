# Second independent federation node — copy to backend/.env on new VPS
# See deploy/FEDERATION-SECOND-NODE.md

APP_ENV=production
BACKEND_URL=https://api.your-school.example.com
FRONTEND_URL=https://app.your-school.example.com
JWT_SECRET=replace-with-openssl-rand-hex-32
DATABASE_URL=postgresql+psycopg://pocp:STRONG_PASSWORD@postgres:5432/pocp

# Unique node identity — python backend/scripts/generate_node_keys.py school-node-1
POCP_NODE_ID=school-node-1
POCP_NODE_PRIVATE_KEY=
POCP_NODE_PUBLIC_KEY=

# full | read_only_mirror
POCP_NODE_MODE=full
POCP_REQUIRE_IMPORT_SIGNATURE=true
POCP_VERIFY_REMOTE_LEDGER=true
POCP_FEDERATION_SYNC_ON_STARTUP=false
POCP_FEDERATION_TRUST_WEIGHT=0.5

# JSON array — one line or use trusted_nodes.yaml
# POCP_TRUSTED_NODES=[{"node_id":"genesis","base_url":"https://api.genesis.example.com","public_key":"<hex>","trust_weight":0.7}]

ENABLE_DEV_LOGIN=false
ENABLE_MOCK_VERIFIER=false

# Optional local inference (NN-2)
# ENABLE_OLLAMA_VERIFIER=true
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# StudyAgent (NN-3) — optional LangGraph: pip install langgraph && ENABLE_LANGGRAPH_STUDY_AGENT=true
STUDY_AGENT_LLM_PROVIDER=mock
