# Copy to project root as `.env` for docker compose variable substitution:
#   cp deploy/.env.production.example .env
#
# These values are used by docker-compose.prod.yml (build args + Postgres password).
# Application secrets (JWT, OAuth, API keys) go in backend/.env — see docs/PUBLIC-DEPLOY.md.

# Strong password — must match DATABASE_URL user password in backend/.env
POSTGRES_PASSWORD=change-me-use-openssl-rand-hex-16

# Public API URL (HTTPS). Baked into frontend at build time.
VITE_API_URL=https://api.your-domain.com
